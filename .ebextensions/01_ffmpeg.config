commands:
  01_install_ffmpeg:
    command: |
      curl -fsSL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz
      mkdir -p /tmp/ffmpeg_tmp
      tar -xJ -f /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg_tmp
      find /tmp/ffmpeg_tmp -name 'ffmpeg' -type f -exec cp {} /usr/local/bin/ffmpeg \;
      chmod +x /usr/local/bin/ffmpeg
      rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg_tmp
    test: "[ ! -f /usr/local/bin/ffmpeg ]"

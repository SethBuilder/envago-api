option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache

commands:
  01_install_composer:
    command: |
      curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
    test: "[ ! -f /usr/local/bin/composer ]"
  02_install_php_extensions:
    command: |
      yum install -y php8.5-mysqlnd php8.5-gd php8.5-mbstring php8.5-xml php8.5-fileinfo php8.5-bcmath php8.5-intl 2>/dev/null || \
      dnf install -y php-mysqlnd php-gd php-mbstring php-xml php-fileinfo php-bcmath php-intl 2>/dev/null || true
      systemctl restart php-fpm 2>/dev/null || true

container_commands:
  00_dirs:
    command: |
      mkdir -p /var/app/staging/bootstrap/cache \
               /var/app/staging/storage/framework/sessions \
               /var/app/staging/storage/framework/views \
               /var/app/staging/storage/framework/cache/data \
               /var/app/staging/storage/app/public \
               /var/app/staging/storage/logs
      chmod -R 777 /var/app/staging/bootstrap /var/app/staging/storage
  01_composer_install:
    command: "composer install --no-dev --optimize-autoloader --no-interaction --no-scripts"
    cwd: "/var/app/staging"
  02_package_discover:
    command: "php artisan package:discover --ansi"
    cwd: "/var/app/staging"
  03_migrate:
    command: "php artisan migrate --force"
    cwd: "/var/app/staging"
    leader_only: true
  04_storage_link:
    command: "php artisan storage:link --force"
    cwd: "/var/app/staging"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache

files:
  "/etc/php.d/99-envago.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 20M
      post_max_size = 25M


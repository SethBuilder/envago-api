option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: apache

container_commands:
  02_storage_permissions:
    command: "chmod -R 775 /var/app/current/storage && chown -R webapp:webapp /var/app/current/storage"

files:
  "/opt/elasticbeanstalk/config/private/logtasks/pull/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [laravel]
      CommandType=get
      Destination=var/log/app-logs/laravel.log
      Frequency=hourly
      Method=cat
      Source=/var/app/current/storage/logs/laravel.log

files:
  "/etc/supervisor.d/lara-worker.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      [program:lara-worker]
      process_name=%(program_name)s
      command=php /var/app/current/artisan queue:work database --queue=lara --sleep=30 --tries=1 --max-time=3600
      autostart=true
      autorestart=true
      stopasgroup=true
      killasgroup=true
      user=webapp
      redirect_stderr=true
      stdout_logfile=/var/log/lara-worker.log
      stdout_logfile_maxbytes=10MB
      stopwaitsecs=420

container_commands:
  01_migrate:
    command: "php /var/app/staging/artisan migrate --force"
    leader_only: true
  02_reload_supervisor:
    command: "supervisorctl reread && supervisorctl update && supervisorctl start lara-worker || true"
    leader_only: false

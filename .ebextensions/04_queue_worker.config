files:
  "/etc/systemd/system/lara-worker.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Lara queue worker
      After=network.target

      [Service]
      User=webapp
      Group=webapp
      WorkingDirectory=/var/app/current
      ExecStart=/usr/bin/php /var/app/current/artisan queue:work database --queue=lara --sleep=30 --tries=1 --max-time=3600
      Restart=always
      RestartSec=5
      StandardOutput=append:/var/log/lara-worker.log
      StandardError=append:/var/log/lara-worker.log

      [Install]
      WantedBy=multi-user.target

container_commands:
  01_migrate:
    command: "php /var/app/staging/artisan migrate --force"
    leader_only: true
  02_start_worker:
    command: "systemctl daemon-reload && systemctl enable lara-worker && systemctl restart lara-worker"
    leader_only: false
